# ── Supabase (wymagane) ──────────────────────────────────────────────────────
# URL projektu: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://twoj-projekt.supabase.co

# Klucz anonimowy (publiczny, używany w przeglądarce do logowania)
# Supabase Dashboard → Project Settings → API → anon public
SUPABASE_ANON_KEY=eyJhbGciOi...

# Klucz service_role (TAJNY! tylko na serwerze, nigdy we froncie)
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Opcjonalne ───────────────────────────────────────────────────────────────
# PORT=8080
